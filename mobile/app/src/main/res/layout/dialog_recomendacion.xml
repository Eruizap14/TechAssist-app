<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cabecera del pop-up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recomendación del Agente"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Categoría de tarea -->
        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mantenimiento Correctivo"
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_secondary"
            android:background="#F5F5F5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Herramienta recomendada — HU-01 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HERRAMIENTA RECOMENDADA"
            android:textSize="11sp"
            android:textColor="@color/color_on_surface_secondary"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️"
                    android:textSize="28sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHerramienta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multímetro Digital"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_background" />

                    <TextView
                        android:id="@+id/tvDescripcionHerramienta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medición de voltajes y resistencias"
                        android:textSize="13sp"
                        android:textColor="@color/color_on_surface_secondary"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Justificación del agente — HU-02 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿POR QUÉ ESTA HERRAMIENTA?"
            android:textSize="11sp"
            android:textColor="@color/color_on_surface_secondary"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFF8E1">

            <TextView
                android:id="@+id/tvExplicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Explicación del agente"
                android:textSize="14sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="4dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Guía de 3 pasos con checkboxes — HU-03 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUÍA DE INICIO RÁPIDO"
            android:textSize="11sp"
            android:textColor="@color/color_on_surface_secondary"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp" />

        <!-- Paso 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkPaso1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="@color/color_primary" />

            <TextView
                android:id="@+id/tvPaso1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paso 1"
                android:textSize="14sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Paso 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkPaso2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="@color/color_primary" />

            <TextView
                android:id="@+id/tvPaso2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paso 2"
                android:textSize="14sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Paso 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkPaso3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:buttonTint="@color/color_primary" />

            <TextView
                android:id="@+id/tvPaso3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paso 3"
                android:textSize="14sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Botón cerrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Entendido ✓"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>