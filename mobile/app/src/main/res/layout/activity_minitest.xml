<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <!-- ── Cabecera: título + puntuación + progreso ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/color_surface"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minitest"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPuntuacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0/12"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_background"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvContador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0% completado"
            android:textSize="12sp"
            android:textColor="#4CAF50"
            android:layout_marginBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressTint="#4CAF50"
            android:progressBackgroundTint="#E0E0E0"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

    <!-- ── Tarjeta con la pregunta ── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/color_surface">

        <TextView
            android:id="@+id/tvPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Pregunta de ejemplo"
            android:textSize="18sp"
            android:textColor="@color/color_on_background"
            android:lineSpacingExtra="4dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ── Opciones de respuesta ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- Opción 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpcion1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_on_surface_secondary"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvOpcion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Opción A"
                android:textSize="15sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Opción 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpcion2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_on_surface_secondary"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvOpcion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Opción B"
                android:textSize="15sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Opción 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpcion3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeColor="@color/color_on_surface_secondary"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvOpcion3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Opción C"
                android:textSize="15sp"
                android:textColor="@color/color_on_background"
                android:lineSpacingExtra="3dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ── Botones Volver / Continuar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="← Volver"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="30dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="→ Continuar"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            app:backgroundTint="#4CAF50"
            app:cornerRadius="30dp" />

    </LinearLayout>

</LinearLayout>